{
  "name": "@canva-banana/desktop",
  "private": true,
  "version": "0.2.6",
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "electron .",
    "start:built": "npm run build && electron .",
    "build": "npm run prepare:package && npm run verify:package",
    "test": "vitest run",
    "prepare:package": "node scripts/prepare-package.mjs",
    "verify:package": "node scripts/verify-package-resources.mjs",
    "verify:mac-app": "node scripts/verify-mac-app.mjs",
