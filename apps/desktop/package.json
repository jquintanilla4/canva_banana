    "make": "node scripts/package-mac-app.mjs make"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron/notarize": "^3.1.1",
    "@electron/packager": "^20.3.0",
    "electron": "^42.11.12"
  }
}
