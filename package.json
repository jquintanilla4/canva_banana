{
  "name": "canva-banana",
  "private": true,
  "version": "0.2.6",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm -w @canva-banana/web run dev",
    "dev:desktop": "npm -w @canva-banana/desktop run dev",
    "dev:backends": "make dev-backends",
    "backend:dev": "npm -w @canva-banana/python-backend run dev",
    "secure-backend:dev": "npm -w @canva-banana/secure-backend run dev",
    "build": "npm run build:web",
    "build:web": "npm -w @canva-banana/web run build",
    "build:desktop": "npm -w @canva-banana/desktop run build",
    "package:mac": "npm -w @canva-banana/desktop run package",
    "make:mac": "npm -w @canva-banana/desktop run make",
    "preview": "npm -w @canva-banana/web run preview",
    "test:web": "npm -w @canva-banana/web run test",
    "test:desktop": "npm -w @canva-banana/desktop run test",
    "test:secure-backend": "npm -w @canva-banana/secure-backend run test",
    "test:python-backend": "npm -w @canva-banana/python-backend run test",
    "test:watch": "npm -w @canva-banana/web run test:watch",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint \"**/*.{ts,tsx,js,jsx}\" --max-warnings=0",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.1",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-react": "^6.1.2",
    "baseline-browser-mapping": "^2.11.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^26.1.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "protobufjs@7.6.6": true,
    "@google/genai@2.27.0": true
  }
}
